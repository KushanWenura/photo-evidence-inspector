{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photo-evidence-location-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "20260916",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": false
  }
}